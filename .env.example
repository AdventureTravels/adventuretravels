# Sleutels staan NIET in git. Haal ze op met: vercel link && vercel env pull .env
# Zie README.md.
DATABASE_URL=
SESSION_SECRET=
API_KEY=
BLOB_READ_WRITE_TOKEN=
MAILERLITE_API_KEY=
RESEND_API_KEY=
PORTAL_URL=https://mijn.adventuretravels.nl
# Alleen nodig om via `npm run db:seed` een eerste admin aan te maken in een lege database
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Publieke site-URL (hreflang/canonical). Standaard https://adventuretravels.nl
NEXT_PUBLIC_SITE_URL=https://adventuretravels.nl
# Zet op "true" zodra de VZR Garant-aansluiting rond is; toont dan het logo in footer en reispagina
VZR_GARANT_ACTIVE=false
